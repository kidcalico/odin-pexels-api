<h1>Pexels API Interface</h1>
<p>Display a Pexels collection by entering in a collection ID.</p>

<%= form_with url: root_path, method: :get do |form| %>
  <%= form.label :id, "Collection id:" %>
  <%= form.text_field :id %>
  <%= form.submit "Display Collection" %>
<% end %>
<%= form_with url: root_path, method: :get do |form| %>
  <%= form.label :search_term, "Search by keyword:" %>
  <%= form.text_field :search_term %>
  <%= form.submit "Display Collection" %>
<% end %>
<br />
<% if @photos && @photos.empty? %>
  <p>Collection not found.</p>
<% elsif @photos %>
  <% @photos.each do |photo| %>
    <%= image_tag(photo) %>
  <% end %>
<% end %>

